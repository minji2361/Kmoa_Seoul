# 로컬: 이 파일을 .env.local 로 복사한 뒤 값을 입력한다. (.env.local 은 Git에 올리지 않는다)
# Vercel: Project → Settings → Environment Variables 에 같은 키를 등록한다.
# K-MOA 전용 Supabase/Vercel 프로젝트의 값만 사용한다. 다른 프로젝트 값은 복사 금지.

# Supabase (K-MOA 전용 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 (클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=

# 외부 신청 폼 주소 (구글폼·네이버폼 등, https:// 로 시작하는 주소만 사용됨)
# 비어 있으면 신청 버튼은 /contact 로 이동한다. 자체 폼으로 전환하면 사용하지 않는다.
NEXT_PUBLIC_APPLY_FORM_URL=
NEXT_PUBLIC_PARTNER_FORM_URL=
